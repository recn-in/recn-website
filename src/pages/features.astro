---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;

// Everything here is in the builds people can download today.
const groups: [string, [string, string][]][] = [
  ['Record', [
    ['Any length', 'Audio streams to disk as you record, so a three-hour rehearsal is as safe as a ten-second idea.'],
    ['See what is going in', 'A live waveform and meters while you record, from the microphone or interface you choose.'],
    ['Metronome and count-in', 'Set a tempo, hear the click, and get a bar to breathe before the take starts.'],
    ['Bring audio in', 'Import recordings you already have. They sit in the library like the ones made here.'],
    ['Record from anywhere on the desktop', 'RECN waits in the tray. A global hotkey starts a quick recording without opening the window.'],
  ]],
  ['Sessions', [
    ['Layer takes', 'Record over a recording. Every layer gets its own lane, in time with the rest.'],
    ['Takes that stay', 'Record again and the new take replaces the old one. The previous take stays one tap away.'],
    ['Edit clips', 'Move, trim, split, mute and delete, one clip or many. Crossfades are worked out for you.'],
    ['Loop, punch and markers', 'Cycle a region, punch in over a phrase, loop-record until it is right, and mark the moments that matter.'],
    ['Level and pan on every track', 'Balance a session as you build it.'],
    ['Save and export', 'Export the mix as audio, or the whole session as a single .recn bundle.'],
  ]],
  ['Notes', [
    ['Notes beside the sound', 'A block editor with images, kept with the recording it is about.'],
    ['Comments on the timeline', 'Pin an annotation to a moment in a recording.'],
    ['A drawing canvas', 'Shapes, lines, text and sketches on a whiteboard that lives in the library like everything else.'],
    ['Notes that merge', 'Edit the same note on two devices. Both sets of words survive.'],
  ]],
  ['Find', [
    ['Transcripts, made on the device', 'Download a speech model once and your phone turns speech into text. The audio never leaves it, and the transcript follows the recording to your other devices.'],
    ['Search as you type', 'Across the whole library on the desktop, however large it gets.'],
    ['Projects, and projects inside projects', 'Keep a record, a client or a term together. Everything in a project travels with it.'],
    ['Five ways to look at a library', 'Feed, Table, Gallery, Columns and Calendar on the desktop, with grouping and stacks.'],
  ]],
  ['Sync', [
    ['Device to device', 'No account and no cloud library. Pair two devices and they keep each other current.'],
    ['Works with no internet', 'In the same room, sync runs over the local network alone.'],
    ['And anywhere else', 'Pair across networks with a QR code. Devices reach each other by key, over an encrypted connection.'],
    ['Green means verified', 'A copy counts only when its length and SHA-256 digest match. The Sync screen shows where every recording really lives.'],
    ['You stay in charge', 'Keep everything on the local network, remove a device, or reset sync entirely. The library is never touched.'],
  ]],
  ['Everywhere', [
    ['macOS, Windows, iPhone, iPad and Android', 'One library across all of them.'],
    ['A real iPad app', 'Split panes, pointer and keyboard, not a stretched phone.'],
    ['A real desktop app', 'Keyboard-first, with a command palette, multi-select and context menus.'],
    ['Stays current', 'Desktop builds update themselves. Phones tell you when a new build is out and what changed.'],
  ]],
  ['Private', [
    ['Yours, on your devices', 'Recordings are stored where you made them and on the devices you pair. Nothing else.'],
    ['Optional diagnostics', 'Crash reports help us fix things. One switch in Settings turns them off.'],
  ]],
];
---

<Base title="What RECN does" description="Everything in RECN today: recording, layered sessions, notes and drawings, transcripts and search, and device-to-device sync across macOS, Windows, iPhone, iPad and Android.">
  <Header />
  <main class="simple-page shell" id="main-content">
    <header class="simple-page__header">
      <p class="label">FEATURES</p>
      <h1>What RECN does</h1>
      <p>A recorder that keeps the sound, the words and the context in one place, on every device you own. This is everything in the builds you can download today.</p>
    </header>

    <div class="log log--features">
      {groups.map(([group, features]) => (
        <section aria-labelledby={`group-${group.toLowerCase()}`}>
          <h2 id={`group-${group.toLowerCase()}`}>{group}</h2>
          <div>
            <article>
              <ul>{features.map(([title, detail]) => <li><strong>{title}</strong>{detail}</li>)}</ul>
            </article>
          </div>
        </section>
      ))}
    </div>

    <div class="download-actions">
      <a class="button button--primary" href={`${base}download/`}>Get RECN <span>→</span></a>
      <a class="button button--secondary" href={`${base}how-it-works/`}>How the sync works <span>→</span></a>
    </div>
  </main>
  <Footer />
</Base>
