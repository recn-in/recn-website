---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RecnMark from '../components/RecnMark.astro';
import { apple, android, windows } from '../lib/platformMarks';
import { PRODUCTS } from '../lib/products';

const base = import.meta.env.BASE_URL;
const releases = 'https://github.com/recn-in/recn-releases/releases';
const brewCommand = 'curl -fsSL https://raw.githubusercontent.com/recn-in/recn-releases/main/install.sh | bash';
const [rec, work, node] = PRODUCTS;

// Direct desktop downloads resolve to the newest versioned beta (or the
// newest nightly before one exists). The Store link stays separate so
// release discovery cannot replace it.
const platforms = [
  { id: 'macos', name: 'macOS', mark: apple, href: releases, action: 'Download .dmg', arrow: '↓', note: 'Signed and notarized', live: true },
  { id: 'windows', name: 'Windows · direct download', mark: windows, href: releases, action: 'Download .exe', arrow: '↓', note: 'Per-user installer', live: true },
  { id: 'windows-store', name: 'Windows · Microsoft Store', mark: windows, href: 'https://apps.microsoft.com/detail/9MWNZ7BZN9Q8', action: 'View in Microsoft Store', arrow: '↗', note: 'Coming soon · use the .exe download for now', live: false },
  { id: 'ios', name: 'iPhone · iPad', mark: apple, href: 'https://testflight.apple.com/join/h2Xw8MpE', action: 'Join on TestFlight', arrow: '↗', note: 'Updates arrive through TestFlight', live: false },
  { id: 'android', name: 'Android', mark: android, href: 'https://play.google.com/apps/testing/com.recn.rec', action: 'Join early access', arrow: '↗', note: 'Updates arrive through Google Play', live: false },
];

const workPlatforms = [
  { id: 'work-macos', name: 'macOS', mark: apple, href: releases, action: 'Download .dmg', arrow: '↓', note: 'Signed and notarized', live: true },
  { id: 'work-windows', name: 'Windows', mark: windows, href: releases, action: 'Download .exe', arrow: '↓', note: 'Per-user installer', live: true },
  { id: 'work-ios', name: 'iPhone · iPad', mark: apple, href: '', action: 'Coming to TestFlight', arrow: '', note: 'Coming soon', live: false },
  { id: 'work-android', name: 'Android', mark: android, href: '', action: 'Coming to Google Play', arrow: '', note: 'Coming soon', live: false },
];

const nodeArchives = [
  { id: 'node-macos-arm64', name: 'macOS · Apple silicon', mark: apple, suffix: 'macos-arm64.tar.gz' },
  { id: 'node-linux-x64', name: 'Linux · x64', mark: '', suffix: 'linux-x64.tar.gz' },
  { id: 'node-linux-arm64', name: 'Linux · arm64', mark: '', suffix: 'linux-arm64.tar.gz' },
  { id: 'node-windows-x64', name: 'Windows · x64', mark: windows, suffix: 'windows-x64.zip' },
];
---

<Base title="Get RECN" description="Rec and Work for macOS, Windows, iPhone, iPad and Android, and RECN Node for a Mac, PC, Linux box or NAS.">
  <Header />
  <main class="simple-page shell" id="main-content">
    <header class="simple-page__header">
      <p class="label">DOWNLOAD</p>
      <h1>Get RECN</h1>
      <p>Three products, one library. Install Rec or Work on two devices and they find each other. Add a RECN Node and the library is always reachable.</p>
      <nav class="page-jump" aria-label="Products on this page">
        {PRODUCTS.map((product) => <a href={`#${product.id}`}><RecnMark product={product.id} />{product.name}</a>)}
      </nav>
    </header>

    <section class="release-browser product-section" id="rec" aria-labelledby="rec-heading" data-release-browser>
      <h2 class="product-head" id="rec-heading"><RecnMark product="rec" />{rec.name}</h2>
      <p>{rec.line}</p>
      <div class="download-grid">
        {platforms.map((platform) => (
          <a href={platform.href} data-release-platform={platform.id}>
            <span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={platform.mark} /></svg>
              {platform.name}
            </span>
            <strong>{platform.action} <b aria-hidden="true">{platform.arrow}</b></strong>
            <small data-asset-meta={platform.live ? '' : undefined}>{platform.note}</small>
          </a>
        ))}
      </div>
      <div class="brew-command">
        <span>Homebrew · macOS</span>
        <div class="brew-command__box">
          <pre><code class="brew-command__line">{brewCommand}</code></pre>
          <button type="button" data-copy={brewCommand} aria-label="Copy Homebrew command">
            <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 3.5v-.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" /></svg>
            <em aria-live="polite">Copy</em>
          </button>
        </div>
        <p class="brew-command__hint">Taps and trusts <code>recn-in/recn</code>, then installs or updates the <code>recn-rec</code> cask. Run it again any time to update.</p>
      </div>

      <article class="release-card">
        <header class="release-card__header">
          <div>
            <p class="release-card__eyebrow">Rec · desktop</p>
            <h3 data-release-name>Latest build</h3>
          </div>
          <time data-release-date></time>
        </header>
        <section class="release-notes" aria-labelledby="release-notes-heading">
          <header>
            <h3 id="release-notes-heading">What changed</h3>
            <a href={`${base}releases/#rec`}>All releases →</a>
          </header>
          <ul data-release-notes>
            <li>The latest notes are on the releases page.</li>
          </ul>
        </section>
      </article>
    </section>

    <section class="release-browser product-section" id="work" aria-labelledby="work-heading">
      <h2 class="product-head" id="work-heading"><RecnMark product="work" />{work.name}</h2>
      <p>{work.line}</p>
      <div class="download-grid">
        {workPlatforms.map((platform) => (
          platform.href === '' ? (
            <div data-release-platform={platform.id}>
              <span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={platform.mark} /></svg>
                {platform.name}
              </span>
              <strong>{platform.action}</strong>
              <small>{platform.note}</small>
            </div>
          ) : (
            <a href={platform.href} data-release-platform={platform.id}>
              <span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={platform.mark} /></svg>
                {platform.name}
              </span>
              <strong>{platform.action} <b aria-hidden="true">{platform.arrow}</b></strong>
              <small data-asset-meta>{platform.note}</small>
            </a>
          )
        ))}
      </div>
    </section>

    <section class="release-browser product-section" id="node" aria-labelledby="node-heading">
      <h2 class="product-head" id="node-heading"><RecnMark product="node" />{node.name}</h2>
      <p>{node.line} Devices pair to it by code; harnesses like Claude Code reach it over MCP. A phone never needs one.</p>
      <div class="download-grid">
        {nodeArchives.map((archive) => (
          <a href={releases} data-release-platform={archive.id} data-node-suffix={archive.suffix}>
            <span>
              {archive.mark && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={archive.mark} /></svg>}
              {archive.name}
            </span>
            <strong>Download <b aria-hidden="true">↓</b></strong>
            <small data-asset-meta>{archive.suffix.endsWith('.zip') ? '.zip' : '.tar.gz'}</small>
          </a>
        ))}
      </div>
      <div class="brew-command">
        <span>Install · three lines</span>
        <div class="brew-command__box">
          <pre><code class="brew-command__line">tar -xzf recn-node-*.tar.gz && cd recn-node-*</code>
<code class="brew-command__line">bin/recn_node service install</code>
<code class="brew-command__line">bin/recn_node service status</code></pre>
          <button type="button" data-copy={'tar -xzf recn-node-*.tar.gz && cd recn-node-*\nbin/recn_node service install\nbin/recn_node service status'} aria-label="Copy install commands">
            <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 3.5v-.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" /></svg>
            <em aria-live="polite">Copy</em>
          </button>
        </div>
        <p class="brew-command__hint">Unpack, install it as a per-user service that starts at login, then open the status page URL it prints (<code>status</code> prints it again any time). Scan the pairing code there from Rec or Work. On Windows unzip and run <code>bin\recn_node.exe service install</code>. <a href={`${base}how-it-works/#node`}>How RECN Node works →</a></p>
      </div>
    </section>

    <p class="build-caveat">Direct macOS and Windows downloads update themselves. Microsoft Store availability is coming soon; use the Windows .exe download for now. This is early software: expect rough edges, and keep copies of recordings that matter. Mobile betas are for ages 13 and over.</p>
  </main>
  <Footer />
</Base>

<script>
  import { RELEASES_API, PRODUCT_TAGS, buildName, changes, type GitHubRelease, type ReleaseAsset } from '../lib/releases';

  const root = document.querySelector<HTMLElement>('[data-release-browser]');

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((copy) => {
    const copyLabel = copy.querySelector('em')!;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copy ?? '');
        copyLabel.textContent = 'Copied';
      } catch {
        // Clipboard blocked (insecure origin, denied permission): select it so ⌘C works.
        getSelection()?.selectAllChildren(copy.previousElementSibling!);
        copyLabel.textContent = 'Press ⌘C';
      }
      copy.classList.add('is-done');
      setTimeout(() => { copyLabel.textContent = 'Copy'; copy.classList.remove('is-done'); }, 1600);
    });
  });

  // The visitor's own platform leads each app's grid.
  const ua = navigator.userAgent;
  const mine = /Android/.test(ua) ? 'android'
    : /iPhone|iPad/.test(ua) || (/Mac/.test(ua) && navigator.maxTouchPoints > 1) ? 'ios'
    : /Mac/.test(ua) ? 'macos'
    : /Windows/.test(ua) ? 'windows' : '';
  document.querySelectorAll(`[data-release-platform="${mine}"], [data-release-platform="work-${mine}"]`)
    .forEach((card) => card.classList.add('is-mine'));

  const setAsset = (platform: string, asset: ReleaseAsset | undefined) => {
    const link = document.querySelector<HTMLAnchorElement>(`[data-release-platform="${platform}"]`);
    const meta = link?.querySelector<HTMLElement>('[data-asset-meta]');
    if (!link || !asset) return;
    link.href = asset.browser_download_url;
    if (meta) meta.textContent = `${asset.name} · ${(asset.size / 1_000_000).toFixed(0)} MB`;
  };

  if (root) {
    fetch(`${RELEASES_API}?per_page=60`, {
      headers: { Accept: 'application/vnd.github+json' },
    })
      .then((response) => {
        if (!response.ok) throw new Error(`GitHub releases: ${response.status}`);
        return response.json() as Promise<GitHubRelease[]>;
      })
      .then((all) => {
        // Newest versioned release whose installers have finished uploading,
        // else the newest nightly with them.
        const ready = (tag: RegExp, ...suffixes: string[]) => all.find((release) => !release.draft
          && tag.test(release.tag_name)
          && suffixes.every((suffix) => release.assets.some((asset) => asset.name.endsWith(suffix))));
        const latest = (id: string, ...suffixes: string[]) => {
          const tags = PRODUCT_TAGS.find((product) => product.id === id)!;
          return ready(tags.version, ...suffixes) ?? ready(tags.nightly, ...suffixes);
        };
        // A release carries each installer twice: a versioned name and a stable alias. Link the versioned one.
        const byName = (release: GitHubRelease | undefined, suffix: string) => {
          const named = release?.assets.filter((asset) => asset.name.endsWith(suffix)) ?? [];
          return named.find((asset) => /\d+\.\d+\.\d+/.test(asset.name)) ?? named[0];
        };

        const rec = latest('rec', '.dmg', '.exe');
        setAsset('macos', byName(rec, '.dmg'));
        setAsset('windows', byName(rec, '.exe'));
        const work = latest('work', '.dmg', '.exe');
        setAsset('work-macos', byName(work, '.dmg'));
        setAsset('work-windows', byName(work, '.exe'));
        document.querySelectorAll<HTMLElement>('[data-node-suffix]').forEach((card) => {
          const suffix = card.dataset.nodeSuffix!;
          setAsset(card.dataset.releasePlatform!, byName(latest('node', suffix), suffix));
        });

        if (!rec) return;

        const name = root.querySelector<HTMLElement>('[data-release-name]');
        const date = root.querySelector<HTMLTimeElement>('[data-release-date]');
        const notes = root.querySelector<HTMLUListElement>('[data-release-notes]');
        if (name) name.textContent = buildName(rec.tag_name);
        if (date && rec.published_at) {
          date.dateTime = rec.published_at;
          date.textContent = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short', year: 'numeric' })
            .format(new Date(rec.published_at));
        }
        const lines = changes(rec.body).slice(0, 8);
        if (notes && lines.length > 0) {
          notes.replaceChildren(...lines.map((line) => {
            const item = document.createElement('li');
            item.textContent = line;
            return item;
          }));
        }
      })
      // The static links already lead to the releases page; say why they stayed.
      .catch((error) => console.warn('Live release details unavailable:', error));
  }
</script>
