---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RecnMark from '../components/RecnMark.astro';
import { PRODUCTS } from '../lib/products';

const base = import.meta.env.BASE_URL;
---

<Base title="Get RECN" description="Rec and Work for macOS, Windows, iPhone, iPad and Android, and RECN Node for a Mac, PC, Linux box or NAS.">
  <Header />
  <main class="simple-page shell" id="main-content">
    <header class="simple-page__header">
      <p class="label">DOWNLOAD</p>
      <h1>Get RECN</h1>
      <p>Three products, one library. Pick one.</p>
    </header>

    <div class="choose" role="list">
      {PRODUCTS.map((product) => (
        <a role="listitem" href={`${base}${product.id}/`}>
          <RecnMark product={product.id} />
          <span>
            <strong>{product.name}</strong>
            <em>{product.line}</em>
            <small>{product.platforms}</small>
          </span>
          <b aria-hidden="true">→</b>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .choose { max-width: 820px; margin-top: 48px; border-top: 1px solid var(--divider); }
  .choose a { display: grid; grid-template-columns: 88px 1fr auto; align-items: center; padding: 26px 0; border-bottom: 1px solid var(--divider); gap: 24px; }
  .choose :global(.recn-mark) { width: 88px; }
  .choose strong { display: block; font-size: 1.2rem; font-weight: 640; letter-spacing: -0.02em; }
  .choose em { display: block; max-width: 520px; margin-top: 6px; color: var(--secondary); font-size: 0.86rem; font-style: normal; line-height: 1.6; }
  .choose small { display: block; margin-top: 10px; color: var(--tertiary); font: 550 0.55rem/1.5 var(--mono); letter-spacing: 0.055em; text-transform: uppercase; }
  .choose b { color: var(--tertiary); font-size: 1.2rem; font-weight: 400; transition: transform 0.2s ease, color 0.2s ease; }
  .choose a:hover b { color: var(--accent); transform: translateX(4px); }
  @media (max-width: 480px) { .choose a { grid-template-columns: 64px 1fr; } .choose :global(.recn-mark) { width: 64px; } .choose b { display: none; } }
</style>
