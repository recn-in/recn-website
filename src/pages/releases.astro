---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RecnMark from '../components/RecnMark.astro';
import { RELEASES_API, byProduct, type GitHubRelease } from '../lib/releases';
import { PRODUCTS } from '../lib/products';

const token = process.env.GITHUB_TOKEN;

// Read at build time, so the page is plain HTML. A failed read fails the
// build and the last good site stays up.
const all: GitHubRelease[] = [];
for (let page = 1; ; page += 1) {
  const response = await fetch(`${RELEASES_API}?per_page=100&page=${page}`, {
    headers: {
      Accept: 'application/vnd.github+json',
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
    },
  });
  if (!response.ok) throw new Error(`recn-releases: HTTP ${response.status}`);
  const batch = await response.json() as GitHubRelease[];
  all.push(...batch);
  if (batch.length < 100) break;
}

const logs = byProduct(all).map((log) => ({ ...log, product: PRODUCTS.find((product) => product.id === log.id)! }));
const longDate = (date: string) => new Date(`${date}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});

// Before the per-build history begins. Dates are the merge dates.
const earlier = [
  ['September 2026', 'Sync moved onto Iroh: encrypted, by device key, across the internet as well as the room.'],
  ['September 2026', 'Reset RECN: unpair every device and start over, keeping your library if you choose to.'],
  ['September 2026', 'Session takes on desktop and phone: record replaces, the previous take stays one tap away.'],
  ['July 2026', 'Desktop Browse rebuilt as one calm, searchable feed.'],
  ['July 2026', 'First beta for macOS and Windows, with self-updating builds. iOS arrives on TestFlight.'],
];
---

<Base title="RECN releases" description="What changed in Rec, Work and RECN Node, release by release.">
  <Header />
  <main class="simple-page shell" id="main-content">
    <header class="simple-page__header">
      <p class="label">RELEASES</p>
      <h1>What changed</h1>
      <p>One section per product. Versioned releases lead; the nightly desktop builds and mobile builds behind them fold away underneath. Each line below is one thing that got better.</p>
      <nav class="page-jump" aria-label="Products on this page">
        {PRODUCTS.map((product) => <a href={`#${product.id}`}><RecnMark product={product.id} />{product.name}</a>)}
      </nav>
    </header>

    {logs.map(({ id, product, versions, builds }) => (
      <section class="product-log product-section" id={id} aria-labelledby={`${id}-releases`}>
        <h2 class="product-head" id={`${id}-releases`}><RecnMark product={id} />{product.name}</h2>
        <div class="log">
          {versions.map((version) => (
            <section aria-labelledby={`${id}-${version.name.replace(/\W+/g, '-')}`}>
              <h3 id={`${id}-${version.name.replace(/\W+/g, '-')}`}><a href={version.url}>{version.name}</a><time datetime={version.date}>{longDate(version.date)}</time></h3>
              <div><article><ul>{version.lines.map((line) => <li>{line}</li>)}</ul></article></div>
            </section>
          ))}
          {versions.length === 0 && (
            <section><h3>No versioned release yet</h3><div><article><ul><li>The builds below are what there is.</li></ul></article></div></section>
          )}
          {id === 'rec' && (
            <section aria-labelledby="earlier">
              <h3 id="earlier">Earlier</h3>
              <div><article><ul>{earlier.map(([when, what]) => <li><span>{when}</span>{what}</li>)}</ul></article></div>
            </section>
          )}
        </div>
        {builds.length > 0 && (
          <details class="log-builds">
            <summary>Nightly and mobile builds · {builds.length} {builds.length === 1 ? 'day' : 'days'}</summary>
            <div class="log">
              {builds.map((day) => (
                <section aria-labelledby={`${id}-day-${day.date}`}>
                  <h3 id={`${id}-day-${day.date}`}><time datetime={day.date}>{longDate(day.date)}</time></h3>
                  <div>
                    {day.entries.map((entry) => (
                      <article>
                        <p class="release-card__eyebrow">{entry.family} · {entry.label}</p>
                        <ul>{entry.lines.map((line) => <li>{line}</li>)}</ul>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </details>
        )}
      </section>
    ))}
  </main>
  <Footer />
</Base>

