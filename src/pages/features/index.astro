---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Story from '../../components/Story.astro';
import { GROUPS, isNew } from '../../lib/features';
import { ACTS } from '../../story/features-story';

const base = import.meta.env.BASE_URL;

// One file per feature in src/content/features, and one act per file in
// src/story/features-story.ts under the same slug. Everything listed is in the
// builds people can download today.
const features = await Promise.all(
  (await getCollection('features'))
    .sort((a, b) => GROUPS.indexOf(a.data.group) - GROUPS.indexOf(b.data.group) || a.data.order - b.data.order)
    .map(async (feature) => ({ ...feature, Words: (await feature.render()).Content })),
);
// In the browser a missing act only costs the drawing, silently; here it costs the build.
const undrawn = features.filter((feature) => !ACTS[feature.slug]).map((feature) => feature.slug);
if (undrawn.length) throw new Error(`features: no act in src/story/features-story.ts for ${undrawn.join(', ')}`);
const groups = GROUPS.map((name) => ({ name, first: features.find((feature) => feature.data.group === name) }));
---

<Base title="What RECN does" description="Everything in RECN today, and what each part does behind the scenes: recording, layered sessions, notes and drawings, transcripts and search, and device-to-device sync across macOS, Windows, iPhone, iPad and Android.">
  <Header />
  <main id="main-content">
    <div class="story" data-story="features">
      <Story />
      <div class="story__chapters shell">
        <section class="story__chapter" data-story-chapter data-act="intro">
          <div class="story__card">
            <p class="label">FEATURES</p>
            <h1>What RECN does</h1>
            <p>A recorder that keeps the sound, the words and the context in one place, on every device you own. Scroll to watch what each part does behind the scenes. Everything here is in the builds you can download today.</p>
            <p class="story__spec story__jump">
              {groups.map(({ name, first }) => first && <a href={`#${first.slug}`}>{name}</a>)}
            </p>
          </div>
        </section>
        {features.map(({ slug, data, Words }) => (
          <section class="story__chapter" id={slug} data-story-chapter data-act={slug}>
            <div class="story__card">
              <p class="label">{data.group.toUpperCase()}{isNew(data.shipped) && <em>New</em>}</p>
              <h2>{data.title}</h2>
              <p>{data.summary}</p>
              <Words />
              <p class="story__spec">{data.platforms.join(' · ')}</p>
            </div>
          </section>
        ))}
      </div>
    </div>
    <div class="shell story-end download-actions">
      <a class="button button--primary" href={`${base}download/`}>Get RECN <span>→</span></a>
      <a class="button button--secondary" href={`${base}how-it-works/`}>How the sync works <span>→</span></a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .label em { margin-left: 10px; color: var(--accent); font-style: normal; }
  .story__spec { text-transform: uppercase; }
  /* Room for the last act to finish while the stage is still on screen. */
  .story__chapters { padding-bottom: 50svh; }
  .story-end { margin-top: 0; padding-bottom: 90px; }
  .story__jump { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .story__jump a { color: var(--secondary); }
  .story__jump a:hover { color: var(--accent); }
</style>
