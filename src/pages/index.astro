---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaveBackdrop from '../components/WaveBackdrop.astro';
import RecnMark from '../components/RecnMark.astro';
import { PRODUCTS } from '../lib/products';

const base = import.meta.env.BASE_URL;

const status: Record<(typeof PRODUCTS)[number]['id'], string> = {
  rec: 'Beta · installers ready · TestFlight and Play',
  work: 'Beta · installers ready · stores soon',
  node: '0.1.0 · service install · MCP',
};

const principles = [
  ['Nearby first.', 'On one network, paired devices sync with no internet. Apart, they reach each other by key: direct when they can, through an encrypted relay when they can’t.'],
  ['Small facts. Big sound.', 'Titles and notes converge quickly. Recordings move separately in 4 MiB pieces that resume after a dropped connection.'],
  ['Green means verified.', 'A copy counts only once its length and SHA-256 digest match. Amber until it sits on every device you paired.'],
  ['No account.', 'Pairing is two devices agreeing. There is no password to lose and nothing for us to read, sell or switch off.'],
  ['Yours, on disk.', 'Facts in a local database, sound and drawings as local files. Nothing waits on a network to open, record or edit.'],
  ['Agent-ready.', 'A RECN Node speaks MCP, so Claude Code and Codex can file notes and drawings that reach your devices through normal sync.'],
];
---

<Base
  title="RECN — Rec, Work and RECN Node"
  description="One family, three products. Rec records, Work writes and draws, RECN Node keeps every library in sync. Device to device, no account, no cloud library."
>
  <Header />

  <main id="main-content">
    <section class="home-hero shell" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="label recn-name">
          {/* The four letters are inside all three words; each word is a third of the family. */}
          <a href={`${base}features/`} aria-label="RECN is three words: record, reckon, reconcile. See what each one means.">
            <span aria-hidden="true"><b>REC</b>ORD<i>catch it before it goes</i></span>
            <span aria-hidden="true"><b>REC</b>KO<b>N</b><i>find it again</i></span>
            <span aria-hidden="true"><b>REC</b>O<b>N</b>CILE<i>every device agrees</i></span>
          </a>
        </p>
        <h1 id="home-title">Three products.<br /><span>One library.</span></h1>
        <p class="home-hero__intro">Rec records. Work writes and draws. RECN Node keeps every library in sync at home or in the studio. Everything moves directly between your own devices. No account. No cloud library.</p>
        <div class="download-actions">
          <a class="button button--primary" href={`${base}download/`}>Get RECN <span>→</span></a>
          <a class="button button--secondary" href={`${base}how-it-works/`}>No account. No cloud. See how <span>→</span></a>
        </div>
        <div class="home-hero__facts" aria-label="Product facts">
          <span><i></i>Device to device</span>
          <span><i></i>macOS · Windows · Linux</span>
          <span><i></i>iPhone · iPad · Android</span>
        </div>
      </div>
      <WaveBackdrop />
    </section>

    <section class="product-cards shell" aria-label="The three products">
      {PRODUCTS.map((product) => (
        <article id={product.id}>
          <RecnMark product={product.id} />
          <h2>{product.name}</h2>
          <p>{product.line}</p>
          <span>{product.platforms}</span>
          <span>{status[product.id]}</span>
          <a class="inline-link" href={`${base}${product.id}/`}>Get {product.name} →</a>
        </article>
      ))}
    </section>

    <section class="home-manifesto shell" aria-labelledby="manifesto-title">
      <p class="label">THE SHORTEST DISTANCE</p>
      <h2 id="manifesto-title">Your phone is three feet from your computer.<br />Your work shouldn’t travel three thousand miles.</h2>
      <p>In the same room, Rec and Work send the file straight across it, with no internet at all. Apart, your devices find each other by key and connect directly when they can, through an encrypted relay when they can’t. A RECN Node is one more device, the one that is always on. Either way, a copy counts only once it is verified.</p>
    </section>

    <section class="capability-list shell" aria-label="Principles shared by every product">
      {principles.map(([title, words], n) => (
        <article>
          <span>0{n + 1}</span>
          <h2>{title}</h2>
          <p>{words}</p>
        </article>
      ))}
    </section>

    <section class="home-closing shell">
      <p class="label">REC · WORK · RECN NODE</p>
      <h2>Start now.<br />Pick up anywhere.</h2>
      <div class="download-actions">
        <a class="button button--primary" href={`${base}download/`}>Get RECN <span>→</span></a>
        <a class="button button--secondary" href={`${base}features/`}>Everything Rec does <span>→</span></a>
      </div>
      <p class="build-caveat">Early builds. Glitches are expected.</p>
      <section class="signup-block" aria-labelledby="home-contact-title">
        <p class="label">GET IN TOUCH</p>
        <h2 id="home-contact-title">Get release updates and private beta notes</h2>
        <form class="signup-form" data-signup>
          <label class="sr-only" for="home-contact-email">Email address</label>
          <input id="home-contact-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
          <button type="submit">Notify me</button>
          <p class="form-status" data-form-status aria-live="polite"></p>
        </form>
        <p class="form-note">Signups are handled by Formspree. We only send product updates and milestone notices.</p>
      </section>
    </section>
  </main>

  <Footer />
</Base>
