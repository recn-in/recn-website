---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaveBackdrop from '../components/WaveBackdrop.astro';

const base = import.meta.env.BASE_URL;
---

<Base
  title="RECN — Your recordings, in motion"
  description="Recordings, notes, and sessions that move directly between your own devices. RECN Rec runs on macOS, Windows, iPhone, iPad and Android."
>
  <Header />

  <main id="main-content">
    <section class="home-hero shell" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="label">RECN · LATTICE</p>
        <h1 id="home-title">Your recordings.<br /><span>In motion.</span></h1>
        <p class="home-hero__intro">Capture on one device. Continue on another. RECN moves recordings and context directly between your own devices. No account. No cloud library.</p>
        <div class="download-actions">
          <a class="button button--primary" href={`${base}download/`}>Get RECN <span>→</span></a>
        </div>
        <div class="home-hero__facts" aria-label="Product facts">
          <span><i></i>Device to device</span>
          <span><i></i>macOS · Windows</span>
          <span><i></i>iOS · TestFlight</span>
          <span><i></i>Android · Google Play</span>
        </div>
      </div>
      <WaveBackdrop />
    </section>

    <section class="home-manifesto shell" aria-labelledby="manifesto-title">
      <p class="label">THE SHORTEST DISTANCE</p>
      <h2 id="manifesto-title">Your phone is three feet from your computer.<br />Your recording shouldn’t travel three thousand miles.</h2>
      <p>In the same room, RECN sends the file straight across it, with no internet at all. Apart, your devices find each other by key and connect directly when they can, through an encrypted relay when they can’t. Either way, a copy counts only once it is verified.</p>
    </section>

    <section class="capability-list shell" aria-label="How RECN sync works">
      <article>
        <span>01</span>
        <h2>Nearby first.</h2>
        <p>On the same network, paired devices sync with no internet. Apart, they reach each other by key.</p>
      </article>
      <article>
        <span>02</span>
        <h2>Small facts. Big sound.</h2>
        <p>Titles and notes converge quickly. Large recordings move separately in resumable chunks.</p>
      </article>
      <article>
        <span>03</span>
        <h2>Green means verified.</h2>
        <p>A copy is complete only after its final length and SHA-256 digest match.</p>
      </article>
    </section>

    <section class="home-system shell" aria-labelledby="system-title">
      <div class="home-system__copy">
        <p class="label">A LIVING LIBRARY</p>
        <h2 id="system-title">See where every recording lives.</h2>
        <p>The app’s Sync screen draws your library as a constellation, and it is not decoration. Its position reveals which devices hold the bytes. Size shows space. Amber means one copy. Green means the recording exists on two or more devices.</p>
        <a class="inline-link" href={`${base}how-it-works/`}>How the sync works →</a>
      </div>
      <div class="home-system__diagram" aria-label="Constellation visual language">
        <div><i class="is-amber"></i><span>ONE COPY</span><strong>Close to one device</strong></div>
        <div><i class="is-green"></i><span>BACKED UP</span><strong>Balanced between devices</strong></div>
        <div><i class="is-ripple"></i><span>SYNCING</span><strong>Expanding transfer pulse</strong></div>
      </div>
    </section>

    <section class="home-closing shell">
      <p class="label">RECN REC</p>
      <h2>Record now.<br />Pick up anywhere.</h2>
      <div class="download-actions">
        <a class="button button--primary" href={`${base}download/`}>Get RECN <span>→</span></a>
        <a class="button button--secondary" href={`${base}features/`}>Everything it does <span>→</span></a>
      </div>
      <p class="build-caveat">Early builds. Glitches are expected.</p>
      <section class="signup-block" aria-labelledby="home-contact-title">
        <p class="label">GET IN TOUCH</p>
        <h2 id="home-contact-title">Get release updates and private beta notes</h2>
        <form class="signup-form" data-signup>
          <label class="sr-only" for="home-contact-email">Email address</label>
          <input id="home-contact-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
          <button type="submit">Notify me</button>
          <p class="form-status" data-form-status aria-live="polite"></p>
        </form>
        <p class="form-note">Signups are handled by Formspree. We only send product updates and milestone notices.</p>
      </section>
    </section>

  </main>

  <Footer />
</Base>
