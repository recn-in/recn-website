---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RecnMark from '../components/RecnMark.astro';
import { PRODUCTS } from '../lib/products';

const base = import.meta.env.BASE_URL;

const steps = [
  ['Install', 'Put Rec or Work on two of your devices.'],
  ['Pair', 'On the same wifi, tap the other device. Anywhere else, scan a code.'],
  ['That\'s it', 'They stay in sync from here on. There is nothing to sign up for.'],
];
---

<Base
  title="RECN"
  description="A suite of apps built on one belief: what you make should live on hardware you own. No account, no cloud. Share directly with the people you work with."
>
  <Header />

  <main class="home shell" id="main-content">
    <section class="hero" aria-labelledby="home-title">
      <h1 id="home-title">What you make should live on hardware you own.</h1>
      <p>RECN is a suite of apps built on that one belief. There is no account and no cloud copy. Your phone and your laptop talk to each other directly. So do you and the people you work with. On the same wifi, none of it needs the internet.</p>
      <div class="actions">
        <a class="button button--primary" href={`${base}download/`}>Download</a>
        <a class="button button--secondary" href={`${base}how-it-works/`}>How it works</a>
      </div>
    </section>

    <section aria-labelledby="products-title">
      <h2 id="products-title" class="label">What we have so far</h2>
      <ul class="products">
        {PRODUCTS.map((product) => (
          <li>
            <a href={`${base}${product.id}/`}>
              <RecnMark product={product.id} />
              <span>
                <b>{product.name}</b>
                <small>{product.line}</small>
              </span>
              <i aria-hidden="true">→</i>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="fit" aria-labelledby="fit-title">
      <h2 id="fit-title" class="label">How it hangs together</h2>
      <div class="fit__body">
        <p><b>Every device holds the whole library.</b> Pair a phone to a laptop and each has a full copy. Edit on one and the other catches up, field by field, so two devices changing different things never fight.</p>
        <p><b>Sharing is a code, not an account.</b> Open a project, show a code, and someone joins it as a viewer or an editor. You see each other's cursors. Their copy is on their hardware, yours is on yours.</p>
        <p><b>No server in the middle.</b> Devices connect to each other directly. When they can't, an encrypted relay passes the bytes along without being able to read them.</p>
        <p><b>RECN Node is the device that never sleeps.</b> Run it on a Mac, a PC or a NAS and there is always one copy awake, backed up every day, under your control. You don't need one. It's there when you want it.</p>
      </div>
    </section>

    <section aria-labelledby="setup-title">
      <h2 id="setup-title" class="label">Setting up</h2>
      <ol class="steps">
        {steps.map(([title, words], n) => (
          <li><span>{n + 1}</span><b>{title}</b><p>{words}</p></li>
        ))}
      </ol>
      <p class="aside">A Node is three commands on the machine you want it on. Then scan its code from Rec or Work. <a href={`${base}node/`}>Set one up →</a></p>
    </section>

    <section class="end">
      <a class="button button--primary" href={`${base}download/`}>Download</a>
      <p>Free while it's in beta. It's early. Keep a copy of anything you'd miss.</p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .home { max-width: 760px; padding-block: clamp(64px, 10vw, 120px) 96px; }
  .home > section + section { margin-top: clamp(72px, 10vw, 112px); }

  .hero h1 { font-size: clamp(2.4rem, 6vw, 3.8rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.04; }
  .hero p { max-width: 600px; margin-top: 22px; color: var(--secondary); font-size: 1.05rem; line-height: 1.7; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

  .products { margin: 18px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--divider); }
  .products a { display: grid; grid-template-columns: 36px 1fr auto; align-items: center; gap: 18px; padding: 18px 0; border-bottom: 1px solid var(--divider); }
  .products :global(.recn-mark) { width: 36px; box-shadow: none; }
  .products span { display: grid; gap: 3px; }
  .products b { font-size: 1rem; font-weight: 640; }
  .products small { color: var(--secondary); font-size: 0.86rem; line-height: 1.55; }
  .products i { color: var(--tertiary); font-style: normal; transition: transform 0.2s ease, color 0.2s ease; }
  .products a:hover i { color: var(--ink); transform: translateX(4px); }

  .fit__body { display: grid; gap: 16px; margin-top: 18px; }
  .fit__body p { color: var(--secondary); font-size: 0.98rem; line-height: 1.7; }
  .fit__body b { color: var(--ink); font-weight: 600; }

  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin: 18px 0 0; padding: 0; list-style: none; }
  .steps span { display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid var(--ink); border-radius: 50%; font: 600 0.75rem/1 var(--mono); }
  .steps b { display: block; margin-top: 14px; font-size: 1.05rem; font-weight: 640; }
  .steps p { margin-top: 6px; color: var(--secondary); font-size: 0.88rem; line-height: 1.6; }
  .aside { margin-top: 30px; color: var(--secondary); font-size: 0.9rem; line-height: 1.7; }
  .aside a { color: var(--ink); border-bottom: 1px solid var(--divider); }

  .end { text-align: center; }
  .end p { margin-top: 14px; color: var(--secondary); font-size: 0.86rem; }

  @media (max-width: 640px) {
    .steps { grid-template-columns: 1fr; gap: 22px; }
    .products a { grid-template-columns: 32px 1fr; gap: 14px; }
    .products :global(.recn-mark) { width: 32px; }
    .products i { display: none; }
  }
</style>
