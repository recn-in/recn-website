---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RecnMark from '../components/RecnMark.astro';
import { PRODUCTS } from '../lib/products';

const base = import.meta.env.BASE_URL;

const status: Record<(typeof PRODUCTS)[number]['id'], string[]> = {
  rec: ['Beta', 'Installers ready', 'TestFlight · Play'],
  work: ['Beta', 'Installers ready', 'Stores soon'],
  node: ['0.1.0', 'Service install', 'MCP'],
};


const principles = [
  ['Nearby first', 'On the same network, your devices sync with no internet. Apart, they find each other by key.'],
  ['Small facts, big sound', 'Names and notes arrive first. Audio follows in pieces that resume if the connection drops.'],
  ['Green means verified', 'A copy counts once its fingerprint matches. Amber until it is on every device you paired.'],
  ['No account', 'Pairing is two devices agreeing. No password to lose. Nothing for us to read or switch off.'],
  ['Yours, on disk', 'Everything is a file or a row on your own device. Nothing waits on a network to open.'],
  ['Agent-ready', 'A RECN Node speaks MCP, so Claude Code and Codex can add notes and drawings to your library.'],
];
---

<Base
  title="RECN — Rec, Work and RECN Node"
  description="One family, three products. Rec records, Work writes and draws, RECN Node keeps every library in sync. Device to device, no account, no cloud library."
>
  <Header />

  <main class="home shell" id="main-content">
    <section class="frame" aria-labelledby="home-title">
      <p class="rule"><span>01 / The family</span><span>No account · No cloud</span></p>
      <div class="hero">
        <div class="hero__copy">
          <h1 id="home-title">Three products.<br />One <em>library</em>.</h1>
          <p class="hero__intro">Rec records. Work writes and draws. RECN Node keeps them in sync. Your work moves between your own devices and nowhere else.</p>
          <div class="hero__actions">
            <a class="button button--primary" href={`${base}download/`}><b aria-hidden="true">↓</b> Download</a>
            <a class="button button--secondary" href={`${base}how-it-works/`}>How it works</a>
            <a class="button button--secondary" href={`${base}releases/`}>Releases</a>
          </div>
          <p class="fine">macOS · Windows · iPhone · iPad · Android · Linux · NAS</p>
        </div>
        <ul class="hero__icons" aria-label="The three products">
          {PRODUCTS.map((product) => (
            <li><a href={`${base}${product.id}/`}><RecnMark product={product.id} />{product.name}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="frame" aria-labelledby="lineup-title">
      <p class="rule"><span id="lineup-title">02 / The lineup</span><span>Pick one</span></p>
      <div class="lineup">
        {PRODUCTS.map((product, n) => (
          <article class="card" id={product.id} style={`--product: ${product.accent}`}>
            <header class="card__tag"><b>0{n + 1}</b><span>{product.kind}</span></header>
            <RecnMark product={product.id} class="card__icon" />
            <h2>{product.name}</h2>
            <p>{product.line}</p>
            <p class="pills pills--status">{status[product.id].map((pill) => <span>{pill}</span>)}</p>
            <p class="pills">{product.platforms.split(' · ').map((pill) => <span>{pill}</span>)}</p>
            <a class="card__go" href={`${base}${product.id}/`}>Get {product.name} <b aria-hidden="true">↗</b></a>
          </article>
        ))}
      </div>
    </section>

    <section class="frame" aria-labelledby="principles-title">
      <p class="rule"><span>03 / Principles</span><span>The same rules for all three</span></p>
      <div class="principles__lead">
        <h2 id="principles-title"><em>Three feet</em>, not three thousand miles.</h2>
        <p>Your phone is next to your computer. Your work should not cross the world to get there.</p>
      </div>
      <div class="principles">
        {principles.map(([title, words], n) => (
          <article>
            <span>0{n + 1}</span>
            <h3>{title}</h3>
            <p>{words}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="frame frame--last" aria-labelledby="start-title">
      <p class="rule"><span>04 / Get started</span><span>Beta · Free</span></p>
      <div class="start">
        <h2 id="start-title">Start now. Pick up <em>anywhere</em>.</h2>
        <p>Install on two devices and they find each other. Early builds: keep copies of what matters.</p>
        <div class="hero__actions">
          <a class="button button--primary" href={`${base}download/`}><b aria-hidden="true">↓</b> Download</a>
        </div>
        <form class="signup-form" data-signup>
          <label class="sr-only" for="home-contact-email">Email address</label>
          <input id="home-contact-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
          <button type="submit">Release updates</button>
          <p class="form-status" data-form-status aria-live="polite"></p>
        </form>
        <p class="form-note">Signups are handled by Formspree. We only send product updates and milestone notices.</p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* A ruled page: every section sits in a framed column, headed by a mono rule. */
  .home { padding-bottom: 0; }
  .frame { border-inline: 1px solid var(--divider); }
  .frame--last { border-bottom: 1px solid var(--divider); }
  .rule {
    display: flex;
    justify-content: space-between;
    padding: 14px 40px;
    border-block: 1px solid var(--divider);
    color: var(--secondary);
    font: 600 0.6rem/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    gap: 20px;
  }
  .rule span + span { color: var(--tertiary); text-align: right; }
  em { color: var(--product, var(--accent)); font-style: normal; }
  .fine { color: var(--tertiary); font: 500 0.58rem/1.6 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }

  /* 01 */
  .hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); align-items: center; padding: clamp(60px, 8vw, 110px) 40px; gap: 60px; }
  .hero h1 { font-size: clamp(2.8rem, 5.2vw, 4.4rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.02; }
  .hero__intro { max-width: 540px; margin-top: 26px; color: var(--secondary); font-size: 1.02rem; line-height: 1.7; }
  .hero__actions { display: flex; flex-wrap: wrap; margin-top: 30px; gap: 10px; }
  .hero__actions .button { gap: 10px; font: 650 0.64rem/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .hero__actions b { font-weight: 400; }
  .hero .fine { margin-top: 14px; }
  .hero__icons { display: flex; justify-content: center; margin: 0; padding: 0; list-style: none; gap: clamp(18px, 3vw, 40px); }
  .hero__icons a { display: grid; justify-items: center; color: var(--secondary); font-size: 0.78rem; font-weight: 500; gap: 12px; transition: color 0.2s ease; }
  .hero__icons a:hover { color: var(--ink); }
  .hero__icons :global(.recn-mark) { width: clamp(72px, 8vw, 104px); height: auto; border: 1px solid var(--divider); border-radius: 22%; box-shadow: 0 10px 30px color-mix(in srgb, #000 35%, transparent); transition: transform 0.25s ease; }
  .hero__icons a:hover :global(.recn-mark) { transform: translateY(-4px); }

  /* 02 */
  .lineup { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .card { position: relative; display: flex; flex-direction: column; padding: 0 0 32px; border-right: 1px solid var(--divider); }
  .card:last-child { border-right: 0; }
  .card__tag { display: flex; border-bottom: 1px solid var(--divider); align-items: center; justify-content: space-between; height: 44px; padding: 0 18px 0 0; color: var(--secondary); font: 600 0.56rem/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .card__tag b { display: grid; width: 48px; height: 100%; place-items: center; background: var(--product); color: #fff; font-weight: 700; }
  :global(.card__icon) { width: 68px; height: 68px; margin: 28px 0 0 18px; border: 1px solid var(--divider); border-radius: 22%; box-shadow: 0 8px 24px color-mix(in srgb, #000 35%, transparent); }
  .card h2 { margin: 16px 18px 0; font-size: 1.55rem; font-weight: 640; letter-spacing: -0.03em; }
  .card > p { margin: 10px 18px 0; color: var(--secondary); font-size: 0.86rem; line-height: 1.6; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .card > .pills--status { margin-top: auto; padding-top: 22px; }
  .pills span { padding: 5px 7px; border: 1px solid var(--divider); color: var(--secondary); font: 600 0.52rem/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .pills--status span { border-color: color-mix(in srgb, var(--product) 55%, transparent); color: var(--product); }
  .card__go { display: inline-flex; align-items: center; margin: 24px 18px 0; color: var(--ink); font: 650 0.58rem/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; gap: 8px; }
  .card__go b { font-weight: 400; color: var(--secondary); transition: transform 0.2s ease, color 0.2s ease; }
  .card__go:hover b { color: var(--product); transform: translate(2px, -2px); }

  /* 03 */
  .principles__lead { padding: clamp(50px, 7vw, 90px) 40px 56px; }
  .principles__lead h2 { font-size: clamp(2.2rem, 4.6vw, 3.6rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.05; }
  .principles__lead p { max-width: 560px; margin-top: 20px; color: var(--secondary); font-size: 0.98rem; line-height: 1.7; }
  .principles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--divider); }
  .principles article { position: relative; padding: 34px 32px 38px; border-right: 1px solid var(--divider); border-bottom: 1px solid var(--divider); }
  .principles article:nth-child(3n) { border-right: 0; }
  .principles article:nth-last-child(-n + 3) { border-bottom: 0; }
  .principles span { position: absolute; top: 16px; right: 18px; color: var(--tertiary); font: 600 0.56rem/1 var(--mono); letter-spacing: 0.12em; }
  .principles h3 { margin-top: 28px; font-size: 1.02rem; font-weight: 640; letter-spacing: -0.015em; }
  .principles p { margin-top: 10px; color: var(--secondary); font-size: 0.82rem; line-height: 1.7; }

  /* 04 */
  .start { padding: clamp(60px, 8vw, 110px) 40px; text-align: center; }
  .start h2 { font-size: clamp(2.4rem, 5.6vw, 4.6rem); font-weight: 600; letter-spacing: -0.05em; line-height: 1.02; }
  .start > p { max-width: 520px; margin: 20px auto 0; color: var(--secondary); font-size: 0.96rem; line-height: 1.7; }
  .start .hero__actions { justify-content: center; }
  .start .signup-form { margin: 44px auto 0; }
  .start .form-note { margin-top: 10px; }

  @media (max-width: 960px) {
    .principles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .principles article:nth-child(3n) { border-right: 1px solid var(--divider); }
    .principles article:nth-child(2n) { border-right: 0; }
    .principles article:nth-last-child(-n + 3) { border-bottom: 1px solid var(--divider); }
    .principles article:nth-last-child(-n + 2) { border-bottom: 0; }
  }
  @media (max-width: 760px) {
    .rule, .hero, .principles__lead, .start { padding-inline: 20px; }
    .rule span + span { display: none; }
    .hero { grid-template-columns: 1fr; gap: 48px; }
    .hero__icons { order: -1; justify-content: flex-start; }
    .lineup, .principles { grid-template-columns: 1fr; }
    .card, .principles article { border-right: 0 !important; border-bottom: 1px solid var(--divider) !important; }
    .card:last-child, .principles article:last-child { border-bottom: 0 !important; }
  }
</style>
