---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Support — RECN" description="Get help with RECN Rec for Android, iOS, and desktop.">
  <Header />
  <main class="simple-page shell" id="main-content">
    <header class="simple-page__header">
      <p class="label">SUPPORT</p>
      <h1>Get help with RECN</h1>
      <p>Email <a href="mailto:sinhashubham472@gmail.com">sinhashubham472@gmail.com</a> for help, beta feedback, or a privacy request.</p>
    </header>
    <section class="prose support-copy" aria-label="Contact RECN support">
      <h2>Reporting a problem</h2>
      <p>Include your device model, operating-system version, RECN version, and what you were doing when the problem happened. Screenshots can help. Please do not include private recordings or sensitive information unless needed to explain the problem.</p>
      <h2>Your data</h2>
      <p>RECN stores your library on your devices. Export anything you want to keep before removing the app or clearing its data. Read our <a href={`${base}privacy/`}>privacy policy</a> for information about diagnostics, sync, and deletion.</p>
      <h2>Beta access</h2>
      <p>Find the current iOS and Android testing options on the <a href={`${base}mobile/`}>mobile page</a>. Beta builds can have bugs; keep copies of important recordings.</p>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .support-copy { max-width: 70ch; color: var(--ink); }
  main a { overflow-wrap: anywhere; }
</style>
