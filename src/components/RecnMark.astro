---
import { PRODUCTS, type ProductId } from '../lib/products';

interface Props {
  product?: ProductId;
  label?: string;
  class?: string;
}
const { product, class: className = '' } = Astro.props;
const label = Astro.props.label ?? (product ? PRODUCTS.find((p) => p.id === product)!.name : 'RECN');
const base = import.meta.env.BASE_URL;
---

<img
  class:list={['recn-mark', className]}
  src={product ? `${base}${product}-icon.svg` : `${base}recn-tape-reels.png`}
  width="1024"
  height="1024"
  alt={label}
/>

<style>
  .recn-mark { display: block; object-fit: contain; }
</style>
