---
import { ICON_VERSION, PRODUCTS, type ProductId } from '../lib/products';

interface Props {
  product?: ProductId;
  label?: string;
  class?: string;
}
const { product, class: className = '' } = Astro.props;
const label = Astro.props.label ?? (product ? PRODUCTS.find((p) => p.id === product)!.name : 'RECN');
const base = import.meta.env.BASE_URL;
---

<img
  class:list={['recn-mark', className]}
  src={`${base}${product ? `${product}-icon` : 'recn-mark'}.svg?v=${ICON_VERSION}`}
  width="1024"
  height="1024"
  alt={label}
/>

<style>
  /* Apple app-icon tile: the SVG is full bleed, the img carries the squircle-ish mask and lift.
     :where keeps specificity low so callers only set width (and may drop the shadow when tiny). */
  :where(.recn-mark) {
    display: block;
    height: auto;
    border-radius: 22.37%;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.28), 0 2px 6px rgb(0 0 0 / 0.12);
    filter: grayscale(1);
    transition: filter 0.25s ease;
  }
  /* The site is monochrome; an icon gets its colour back when you point at it or its link. */
  .recn-mark:hover, :global(a:hover) .recn-mark, :global(a:focus-visible) .recn-mark { filter: none; }
</style>
