---
interface Props {
  label?: string;
  class?: string;
}
const { label = 'RECN', class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<img
  class:list={['recn-mark', className]}
  src={`${base}recn-tape-reels.png`}
  width="1024"
  height="1024"
  alt={label}
/>

<style>
  .recn-mark { display: block; object-fit: contain; }
</style>
